<Window x:Class="iLand.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="iLand"
        Width="190"
        Height="48"
        MinWidth="190"
        MinHeight="48"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual">

    <Window.Resources>
        <LinearGradientBrush x:Key="IslandBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#1B1C20" Offset="0"/>
            <GradientStop Color="#0A0B0D" Offset="0.5"/>
            <GradientStop Color="#030304" Offset="1"/>
        </LinearGradientBrush>
    </Window.Resources>

    <Border x:Name="Island"
            Background="{StaticResource IslandBrush}"
            BorderBrush="#46474B"
            BorderThickness="1"
            CornerRadius="26"
            Padding="14"
            ClipToBounds="True"
            MouseEnter="Island_MouseEnter"
            MouseLeave="Island_MouseLeave"
            MouseWheel="Island_MouseWheel"
            MouseLeftButtonDown="Island_MouseLeftButtonDown"
            MouseLeftButtonUp="Island_MouseLeftButtonUp">

        <Border.Effect>
            <DropShadowEffect BlurRadius="24"
                              ShadowDepth="7"
                              Direction="270"
                              Opacity="0.45"
                              Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="26"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Capsule header -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Ellipse Width="8"
                         Height="8"
                         Fill="#30D158"
                         VerticalAlignment="Center"
                         Margin="0,0,9,0"/>

                <TextBlock x:Name="IslandTitle"
                           Grid.Column="1"
                           Text="iLand"
                           Foreground="#F5F5F7"
                           FontSize="12"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>

                <TextBlock x:Name="PageIndicator"
                           Grid.Column="2"
                           Text="1 / 3"
                           Foreground="#89898E"
                           FontSize="10"
                           VerticalAlignment="Center"/>
            </Grid>

            <!-- Expanded pages -->
            <Grid x:Name="ExpandedContent"
                  Grid.Row="1"
                  Visibility="Collapsed"
                  Margin="0,10,0,0">

                <Grid x:Name="HomePage" Visibility="Visible">
                    <StackPanel>
                        <TextBlock x:Name="ClockText"
                                   Text="12:00"
                                   FontSize="34"
                                   FontWeight="SemiBold"
                                   Foreground="White"/>

                        <TextBlock x:Name="DateText"
                                   Text="Today"
                                   Foreground="#A1A1A6"
                                   FontSize="12"
                                   Margin="0,2,0,14"/>

                        <Border Background="#191A1E"
                                BorderBrush="#2D2E32"
                                BorderThickness="1"
                                CornerRadius="15"
                                Padding="13">
                            <StackPanel>
                                <TextBlock Text="iLAND"
                                           Foreground="#8E8E93"
                                           FontSize="10"
                                           FontWeight="SemiBold"/>

                                <TextBlock Text="Уведомления Windows"
                                           Foreground="White"
                                           FontSize="14"
                                           Margin="0,6,0,2"/>

                                <TextBlock Text="Наведите курсор, чтобы открыть остров"
                                           Foreground="#929298"
                                           FontSize="11"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <StackPanel x:Name="SystemPage" Visibility="Collapsed">
                    <TextBlock Text="СИСТЕМА"
                               Foreground="#929298"
                               FontSize="10"
                               Margin="0,0,0,14"/>

                    <TextBlock x:Name="CpuText"
                               Text="CPU  --%"
                               Foreground="White"
                               FontSize="13"/>

                    <ProgressBar x:Name="CpuBar"
                                 Maximum="100"
                                 Height="5"
                                 Margin="0,6,0,16"
                                 Foreground="#76D96B"
                                 Background="#292A2E"/>

                    <TextBlock x:Name="RamText"
                               Text="RAM  --%"
                               Foreground="White"
                               FontSize="13"/>

                    <ProgressBar x:Name="RamBar"
                                 Maximum="100"
                                 Height="5"
                                 Margin="0,6,0,16"
                                 Foreground="#65A9FF"
                                 Background="#292A2E"/>
                </StackPanel>

                <StackPanel x:Name="NotificationsPage" Visibility="Collapsed">
                    <TextBlock Text="УВЕДОМЛЕНИЯ"
                               Foreground="#929298"
                               FontSize="10"
                               Margin="0,0,0,12"/>

                    <TextBlock x:Name="NotificationStatusText"
                               Text="Проверяю доступ Windows к уведомлениям…"
                               Foreground="#D0D0D4"
                               FontSize="12"
                               TextWrapping="Wrap"/>

                    <TextBlock Text="Для Discord и Spotify включите уведомления в настройках Windows."
                               Foreground="#88888E"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Margin="0,12,0,0"/>
                </StackPanel>

                <!-- Page navigation -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Bottom">
                    <Button Content="‹"
                            Click="PreviousPage"
                            Background="Transparent"
                            Foreground="#A0A0A5"
                            FontSize="18"
                            BorderThickness="0"
                            Padding="8,0"/>

                    <Button Content="›"
                            Click="NextPage"
                            Background="Transparent"
                            Foreground="#A0A0A5"
                            FontSize="18"
                            BorderThickness="0"
                            Padding="8,0"/>
                </StackPanel>
            </Grid>

            <!-- Animated notification card -->
            <Border x:Name="ToastCard"
                    Grid.RowSpan="2"
                    Visibility="Collapsed"
                    Opacity="0"
                    VerticalAlignment="Top"
                    Margin="0,34,0,0"
                    Background="#222328"
                    BorderBrush="#42434A"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="13"
                    IsHitTestVisible="False">

                <Border.RenderTransform>
                    <TranslateTransform x:Name="ToastTransform" Y="-14"/>
                </Border.RenderTransform>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="38"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border x:Name="ToastIconBackground"
                            Width="30"
                            Height="30"
                            CornerRadius="10"
                            Background="#5865F2"
                            VerticalAlignment="Top">
                        <TextBlock x:Name="ToastIcon"
                                   Text="D"
                                   Foreground="White"
                                   FontWeight="Bold"
                                   FontSize="16"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <TextBlock x:Name="ToastApp"
                                   Text="Discord"
                                   Foreground="#C5C5CA"
                                   FontSize="10"
                                   FontWeight="SemiBold"/>

                        <TextBlock x:Name="ToastTitle"
                                   Text="Новое уведомление"
                                   Foreground="White"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"/>

                        <TextBlock x:Name="ToastBody"
                                   Text=""
                                   Foreground="#B7B7BC"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   MaxHeight="42"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
