<Window x:Class="iLand.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="iLand"
        Width="190"
        Height="48"
        MinWidth="190"
        MinHeight="48"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual">

    <Window.Resources>
        <LinearGradientBrush x:Key="CapsuleBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#191A1E" Offset="0"/>
            <GradientStop Color="#050506" Offset="1"/>
        </LinearGradientBrush>
    </Window.Resources>

    <Border x:Name="Island"
            Background="{StaticResource CapsuleBrush}"
            BorderBrush="#45464A"
            BorderThickness="1"
            CornerRadius="26"
            Padding="14"
            ClipToBounds="True"
            MouseEnter="Island_MouseEnter"
            MouseLeave="Island_MouseLeave"
            MouseWheel="Island_MouseWheel"
            MouseLeftButtonDown="Island_MouseLeftButtonDown"
            MouseLeftButtonUp="Island_MouseLeftButtonUp">

        <Border.Effect>
            <DropShadowEffect BlurRadius="26"
                              ShadowDepth="7"
                              Direction="270"
                              Opacity="0.48"
                              Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="26"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Ellipse Width="8"
                         Height="8"
                         Fill="#30D158"
                         VerticalAlignment="Center"
                         Margin="0,0,9,0"/>

                <TextBlock x:Name="IslandTitle"
                           Grid.Column="1"
                           Text="iLand"
                           Foreground="#F5F5F7"
                           FontSize="12"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>

                <TextBlock x:Name="PageIndicator"
                           Grid.Column="2"
                           Text="1 / 3"
                           Foreground="#88888D"
                           FontSize="10"
                           VerticalAlignment="Center"/>
            </Grid>

            <Grid Grid.Row="1"
                  x:Name="ExpandedContent"
                  Visibility="Collapsed"
                  Margin="0,10,0,0">

                <Grid x:Name="HomePage" Visibility="Visible">
                    <StackPanel>
                        <TextBlock x:Name="ClockText"
                                   Text="12:00"
                                   FontSize="34"
                                   FontWeight="SemiBold"
                                   Foreground="White"/>

                        <TextBlock x:Name="DateText"
                                   Text="Today"
                                   Foreground="#A1A1A6"
                                   FontSize="12"
                                   Margin="0,2,0,14"/>

                        <Border Background="#18191D"
                                BorderBrush="#2A2B30"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="12">
                            <StackPanel>
                                <TextBlock Text="NOW PLAYING"
                                           Foreground="#8C8C92"
                                           FontSize="10"/>

                                <TextBlock x:Name="MusicText"
                                           Text="No active media"
                                           Foreground="White"
                                           FontSize="13"
                                           Margin="0,7,0,0"
                                           TextTrimming="CharacterEllipsis"/>

                                <TextBlock x:Name="MediaSourceText"
                                           Text="Windows media session"
                                           Foreground="#707075"
                                           FontSize="10"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <StackPanel x:Name="SystemPage" Visibility="Collapsed">
                    <TextBlock Text="SYSTEM"
                               Foreground="#8C8C90"
                               FontSize="10"
                               Margin="0,0,0,12"/>

                    <TextBlock x:Name="CpuText"
                               Text="CPU  --"
                               Foreground="White"
                               FontSize="12"/>

                    <ProgressBar x:Name="CpuBar"
                                 Maximum="100"
                                 Height="5"
                                 Margin="0,5,0,12"
                                 Foreground="#7ED957"
                                 Background="#202125"/>

                    <TextBlock x:Name="RamText"
                               Text="RAM  --"
                               Foreground="White"
                               FontSize="12"/>

                    <ProgressBar x:Name="RamBar"
                                 Maximum="100"
                                 Height="5"
                                 Margin="0,5,0,12"
                                 Foreground="#F7B955"
                                 Background="#202125"/>
                </StackPanel>

                <StackPanel x:Name="NotificationsPage" Visibility="Collapsed">
                    <TextBlock Text="NOTIFICATIONS"
                               Foreground="#8C8C90"
                               FontSize="10"
                               Margin="0,0,0,12"/>

                    <TextBlock x:Name="NotificationStatusText"
                               Text="Demo notifications are active"
                               Foreground="#D0D0D4"
                               FontSize="12"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Bottom">
                    <Button Content="●"
                            Click="PreviousPage"
                            Background="Transparent"
                            Foreground="#606066"
                            BorderThickness="0"
                            Padding="6,0"/>

                    <Button Content="●"
                            Click="NextPage"
                            Background="Transparent"
                            Foreground="#606066"
                            BorderThickness="0"
                            Padding="6,0"/>
                </StackPanel>
            </Grid>

            <Border x:Name="ToastCard"
                    Grid.RowSpan="2"
                    Opacity="0"
                    Visibility="Collapsed"
                    VerticalAlignment="Top"
                    Margin="0,34,0,0"
                    Background="#202126"
                    BorderBrush="#414249"
                    BorderThickness="1"
                    CornerRadius="18"
                    Padding="14"
                    IsHitTestVisible="False">

                <Border.RenderTransform>
                    <TranslateTransform x:Name="ToastShift" Y="-18"/>
                </Border.RenderTransform>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="38"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border x:Name="ToastIconBackground"
                            Width="30"
                            Height="30"
                            CornerRadius="10"
                            Background="#5865F2"
                            VerticalAlignment="Top">
                        <TextBlock x:Name="ToastIcon"
                                   Text="D"
                                   Foreground="White"
                                   FontWeight="Bold"
                                   FontSize="16"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1"
                                Margin="8,0,0,0">
                        <TextBlock x:Name="ToastApp"
                                   Text="Discord"
                                   Foreground="#C6C6CA"
                                   FontSize="10"
                                   FontWeight="SemiBold"/>

                        <TextBlock x:Name="ToastTitle"
                                   Text="New notification"
                                   Foreground="White"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"/>

                        <TextBlock x:Name="ToastBody"
                                   Text=""
                                   Foreground="#B7B7BC"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   MaxHeight="42"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
